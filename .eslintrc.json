{
  "extends": "athom/homey-app",
  "ignorePatterns": ["web/"],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".ts", ".json"]
      }
    },
    "node": {
      "tryExtensions": [".js", ".ts", ".json", ".node"]
    }
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", { "js": "never", "ts": "never" }]
  }
}
