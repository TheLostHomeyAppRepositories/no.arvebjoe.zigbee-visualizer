{
  "id": "no.arvebjoe.zigbee-visualizer",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "brandColor": "#E8951F",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Zigbee Visualizer"
  },
  "description": {
    "en": "See how your devices really reach each other, and where the signal struggles."
  },
  "category": [
    "tools"
  ],
  "tags": {
    "en": [
      "network",
      "mesh",
      "map",
      "diagnostics",
      "signal",
      "coverage",
      "topology"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getZigbeeGraph": {
      "method": "GET",
      "path": "/network"
    },
    "getZigbeeState": {
      "method": "GET",
      "path": "/state"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arve Bjørnerud",
    "email": "arvebjoe@hotmail.com"
  }
}
