{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "no.arvebjoe.zigbee-visualizer",
  "version": "1.3.1",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "brandColor": "#E8951F",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Zigbee Visualizer"
  },
  "description": {
    "en": "See how your devices really reach each other, and where the signal struggles."
  },
  "category": [
    "tools"
  ],
  "tags": {
    "en": [
      "network",
      "mesh",
      "map",
      "diagnostics",
      "signal",
      "coverage",
      "topology"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getZigbeeGraph": {
      "method": "GET",
      "path": "/network"
    },
    "getZigbeeState": {
      "method": "GET",
      "path": "/state"
    },
    "getVisualizerUrl": {
      "method": "GET",
      "path": "/visualizer"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arve Bjørnerud",
    "email": "arvebjoe@hotmail.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Danee de Kruijff"
      }
    ]
  },
  "source": "https://github.com/arvebjoe/no.arvebjoe.zigbee-visualizer",
  "bugs": {
    "url": "https://github.com/arvebjoe/no.arvebjoe.zigbee-visualizer/issues"
  },
  "support": "https://github.com/arvebjoe/no.arvebjoe.zigbee-visualizer/issues",
  "widgets": {
    "network-map": {
      "name": {
        "en": "Zigbee map"
      },
      "height": "100%",
      "settings": [
        {
          "id": "shape",
          "type": "dropdown",
          "title": {
            "en": "Shape"
          },
          "value": "square",
          "values": [
            {
              "id": "square",
              "title": {
                "en": "Square"
              }
            },
            {
              "id": "wide",
              "title": {
                "en": "Wide"
              }
            },
            {
              "id": "tall",
              "title": {
                "en": "Tall"
              }
            }
          ]
        },
        {
          "id": "labels",
          "type": "dropdown",
          "title": {
            "en": "Names"
          },
          "value": "none",
          "values": [
            {
              "id": "none",
              "title": {
                "en": "Only the device you tap"
              }
            },
            {
              "id": "routers",
              "title": {
                "en": "Routers"
              }
            },
            {
              "id": "all",
              "title": {
                "en": "All devices"
              }
            }
          ]
        },
        {
          "id": "summary",
          "type": "checkbox",
          "title": {
            "en": "Show link quality counts"
          },
          "value": true
        },
        {
          "id": "ghosts",
          "type": "checkbox",
          "title": {
            "en": "Show stale routes"
          },
          "value": false
        },
        {
          "id": "refresh",
          "type": "number",
          "title": {
            "en": "Refresh every (minutes)"
          },
          "value": 5,
          "min": 1,
          "max": 60
        }
      ],
      "api": {
        "getView": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "network-map"
    }
  }
}